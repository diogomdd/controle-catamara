rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function usuarioAutorizado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuariosAutorizados/$(request.auth.uid));
    }

    match /usuariosAutorizados/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /registrosGuias/{documento} { allow read, write: if usuarioAutorizado(); }
    match /registrosEmbarcacoes/{documento} { allow read, write: if usuarioAutorizado(); }
    match /prestacoes/{documento} { allow read, write: if usuarioAutorizado(); }
    match /historicoExclusoes/{documento} { allow read, write: if usuarioAutorizado(); }
    match /config/{documento} { allow read, write: if usuarioAutorizado(); }
    match /{documento=**} { allow read, write: if false; }
  }
}
